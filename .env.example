# Shinigami Eyes server config. Installed to /etc/shinigami/.env (0640 root:shinigami).
# Never commit real values.
SHINIGAMI_STATIC_DIR=/opt/shinigami/web/dist
SHINIGAMI_DB_PATH=/var/lib/shinigami/shinigami.db
SHINIGAMI_PLACES_PATH=/etc/shinigami/places.toml
SHINIGAMI_TILES_PATH=/var/lib/shinigami/tiles/greater-melbourne.pmtiles
SHINIGAMI_CONTACT_EMAIL=

# Future keys (see .planning/API-KEYS.md); leave empty until issued.
# GTFSR_KEY=
# PTV_DEVID=
# PTV_KEY=
# EPA_KEY=
# OPENELECTRICITY_KEY=
# AISSTREAM_KEY=
