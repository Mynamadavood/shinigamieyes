[Unit]
Description=Shinigami Eyes backend (FastAPI, loopback only; published by tailscale serve)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=shinigami
WorkingDirectory=/opt/shinigami
EnvironmentFile=/etc/shinigami/.env
Environment=PYTHONUNBUFFERED=1
Environment=SHINIGAMI_TILES_PATH=/var/lib/shinigami/tiles/greater-melbourne.pmtiles
Environment=SHINIGAMI_CAMERAS_PATH=/var/lib/shinigami/data/cameras.json
ExecStart=/opt/shinigami/.venv/bin/uvicorn shinigami.main:app --host 127.0.0.1 --port 8000 --workers 1 --no-access-log --timeout-graceful-shutdown 5
Restart=always
RestartSec=2
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
StateDirectory=shinigami
StateDirectoryMode=0750
UMask=0027
# Sandbox (review CR-01/WR-09): the service can write only its StateDirectory
# (/var/lib/shinigami, the SQLite db) and its private /tmp. Code, venv and the PWA it
# serves are read-only to it. Kept to options that work in an unprivileged LXC.
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
